APP_ENV=dev
DATABASE_URL=sqlite:///./app.db
SQL_ECHO=true
OTHER_API_BASE=http://localhost:8002

# SMTP Configuration - Leave SMTP_HOST empty to skip email sending in dev
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_STARTTLS=false

# RabbitMQ connection for local development
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest